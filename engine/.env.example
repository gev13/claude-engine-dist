# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fallback only: the live site name is set in the installer and in Settings.
SITE_NAME="My Site"

# ─── Database ────────────────────────────────────────────────────────────────
# Docker Compose default (npm run db:up). Change if you run Postgres natively.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/engine

# ─── Auth secrets ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
AUTH_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
# How long a signed-in admin session lasts before the browser must silently
# refresh it. Raising it keeps people signed in across a working day; the cost
# is that a stolen access cookie stays valid for longer. A deactivated or
# role-changed account still loses access immediately — the session is re-read
# from the database on every request, not trusted from the token.
AUTH_ACCESS_TTL=28800          # seconds (8 hours)
AUTH_REFRESH_TTL=2592000       # seconds (30 days)
AUTH_COOKIE_DOMAIN=
AUTH_TOTP_ISSUER="My Site"
# The single switch for the second factor. With it off the password alone
# completes a login, including for accounts that have already enrolled an
# authenticator — their secret is kept, so turning this back on restores the
# challenge without re-enrolment. Off is a development convenience only:
# production must run with it on.
AUTH_REQUIRE_2FA=true

# ─── Settings secrets ────────────────────────────────────────────────────────
# Encrypts secrets kept in settings rows — today the SMTP password. Optional:
# the access secret is used when this is empty, so an existing site needs no
# new value. Changing either means those secrets must be entered again.
SETTINGS_SECRET=

# ─── Engine updates and backups ──────────────────────────────────────────────
# Where the release feed lives. An environment value rather than a setting on
# purpose: an address an administrator could type is an address this server
# would then fetch.
# Sites fetch this unauthenticated, so the repository holding it must be
# public. While it is private the panel simply reports that the feed could not
# be read — checking fails closed and nothing else is affected.
ENGINE_RELEASE_FEED=https://raw.githubusercontent.com/gev13/claude-engine-dist/main/releases.json
# Whether this site may update itself from the panel. Applying an update runs
# git, npm and a build on the server, so it stays off unless you turn it on.
# With it off the panel still says when a new release exists — see
# docs/updating.md for the manual route.
ENGINE_UPDATE_ENABLED=false
# Where backup archives are written. Inside storage/, which git ignores.
BACKUP_DIR=./storage/backups

# ─── Media ───────────────────────────────────────────────────────────────────
MEDIA_STORAGE_DIR=./storage/media
MEDIA_MAX_FILE_BYTES=104857600 # 100 MB
MEDIA_MAX_FILES_PER_UPLOAD=100

# ─── Search (optional; blog only) ────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7701
MEILISEARCH_MASTER_KEY=masterKeyChangeMe
MEILISEARCH_ENABLED=false

# ─── Demo accounts (npm run setup:demo — local development only) ─────────────
# Published passwords. Never run setup:demo against a database that matters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_EDITOR_EMAIL=editor@example.com
SEED_EDITOR_PASSWORD=Editor123!

# ─── Smoke test login (optional) ─────────────────────────────────────────────
# With these set, npm run test:smoke also checks the real login flow against
# this account — including one deliberately wrong password per run, so use a
# test account rather than your own.
SMOKE_EMAIL=
SMOKE_PASSWORD=

# ─── IndexNow (optional, production only) ────────────────────────────────────
# Generate any 32-char hex string, then also write it to public/<key>.txt
# containing exactly the key. Bing, Yandex, Seznam and Naver read it.
# Google does not use IndexNow — it picks changes up from the sitemap.
INDEXNOW_KEY=
