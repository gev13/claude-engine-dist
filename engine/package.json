{
  "name": "site",
  "version": "3.6.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx src/server/db/seed.ts",
    "setup": "drizzle-kit push --force && npm run db:sql",
    "search:index": "NODE_OPTIONS=--conditions=react-server tsx scripts/reindex.ts",
    "transfer:schema": "tsx scripts/transfer-schema.ts",
    "retention:sweep": "NODE_OPTIONS=--conditions=react-server tsx scripts/sweep-retention.ts",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "test": "vitest run",
    "db:seed:force": "NODE_OPTIONS=--conditions=react-server tsx src/server/db/seed.ts --force",
    "db:seed:demo": "NODE_OPTIONS=--conditions=react-server tsx src/server/db/seed-demo.ts",
    "db:seed:demo:force": "NODE_OPTIONS=--conditions=react-server tsx src/server/db/seed-demo.ts --force",
    "db:sql": "node scripts/apply-sql.mjs",
    "db:baseline": "node scripts/baseline-migrations.mjs",
    "db:status": "node scripts/db-status.mjs",
    "db:generate": "drizzle-kit generate",
    "test:smoke": "node scripts/smoke.mjs",
    "setup:demo": "npm run setup && npm run db:seed",
    "publish:dist": "node scripts/publish-dist.mjs",
    "release:merge": "node scripts/merge-release.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tinymce/tinymce-react": "^6.3.0",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.2",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.12",
    "lottie-web": "5.13.0",
    "meilisearch": "^0.60.0",
    "nanoid": "^6.0.1",
    "next": "^15.5.25",
    "nodemailer": "^10.0.9",
    "otplib": "^13.5.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "swr": "^2.5.1",
    "tinymce": "^8.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  },
  "license": "MIT"
}
