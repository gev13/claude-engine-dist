                    "maxLength": 64
                  },
                  "twitterCard": {
                    "type": "string",
                    "enum": [
                      "summary",
                      "summary_large_image"
                    ]
                  },
                  "jsonLd": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "extraMeta": {
                    "maxItems": 40,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "property": {
                          "type": "string"
                        },
                        "content": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "content"
                      ]
                    }
                  }
                }
              },
              "parentId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "sortOrder": {
                "type": "integer"
              },
              "isSystem": {
                "type": "boolean"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
