                ],
                "maxLength": 500
              },
              "seo": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "exactTitle": {
                    "type": "boolean"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "canonicalUrl": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "robots": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "ogTitle": {
                    "type": "string",
